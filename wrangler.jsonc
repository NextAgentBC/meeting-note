{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Your Meeting Note's name. Its address will be https://meeting-note.<your-subdomain>.workers.dev
  "name": "meeting-note",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The app itself (public/). Only /api/* and /cal/* run the Worker. Every /api route except
  // sign-in needs the owner's passkey session; /cal/<private address>.ics is the calendar feed.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cal/*"]
  },

  // Workers AI: Whisper transcribes, GLM writes the notes.
  "ai": { "binding": "AI" },

  // D1: meetings, transcripts, notes, AI usage, and the owner's passkeys.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeting-note-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // KV: the audio chunks, each deleted automatically after AUDIO_RETENTION_DAYS.
  // (R2 would be the usual choice, but it needs a card on file, even on the free plan.)
  "kv_namespaces": [{ "binding": "AUDIO", "id": "00000000000000000000000000000000" }],

  // Queues: transcription and note-writing run in the background, one job at a time.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "meeting-note-jobs" }],
    "consumers": [
      {
        "queue": "meeting-note-jobs",
        // One job per invocation: a batch of Whisper calls runs sequentially and
        // can outlive the consumer's time budget, which retries the whole batch.
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  "vars": {
    "ASR_MODEL": "@cf/openai/whisper-large-v3-turbo",
    // GLM-4.7-flash writes clean Simplified Chinese and English. Avoid Llama 3.3 here: with a JSON
    // schema it garbles Chinese characters.
    "SUMMARY_MODEL": "@cf/zai-org/glm-4.7-flash",
    "FINAL_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Turns dictated plans into dated calendar entries.
    "PLAN_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Answers questions about past meetings and plans.
    "ASK_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Used only when the owner turns on photo understanding in Me.
    "VISION_MODEL": "@cf/llava-hf/llava-1.5-7b-hf",
    // "simplified" converts any Traditional characters Whisper produces; "off" leaves them.
    "CHINESE_SCRIPT": "simplified",
    // Workers Free stops Workers AI at 10,000 neurons a day, roughly two hours of recording.
    "FREE_DAILY_NEURONS": "10000",
    "WORKERS_PLAN": "free",
    "AUDIO_RETENTION_DAYS": "7",
    "SEGMENT_TARGET_MINUTES": "5"
  }
}
